# Serveur
PORT=3000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=plateforme_pret_livres

# JWT (authentification)
JWT_SECRET=change_ce_secret_en_production
