# Email (Nodemailer) - pour le mot de passe oublié
# Exemple Gmail (mot de passe d'application de 16 caractères, validation en 2 étapes requise) :
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASSWORD=mot_de_passe_application_16_caracteres
EMAIL_FROM="IndramBoky <votre.adresse@gmail.com>"

# URL du frontend (utilisée dans le lien de réinitialisation)
FRONTEND_URL=http://localhost:3000
